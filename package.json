{
  "name": "nanohub-swarm",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check": "turbo run check",
    "preview": "bun run --filter @swarm/web preview",
    "test:repository": "bun run --filter @swarm/api test:repository",
    "nh": "bun packages/cli/bin/nh.mjs",
    "nanohub": "bun packages/cli/bin/nh.mjs",
    "test:cli": "bun run --filter @nanohub/cli test",
    "test:hosted-fixture": "tsrs --noEmit -p tools/hosted-git-fixture/tsconfig.json && bun test tools/hosted-git-fixture/fixture.test.ts && node --test tools/hosted-git-fixture/proxy.test.mjs",
    "test:hosted-recovery": "tsrs --noEmit -p tools/hosted-recovery-fixture/tsconfig.json && bun test tools/hosted-recovery-fixture/fixture.test.ts"
  },
  "devDependencies": {
    "tsrs": "0.18.0-ts7.1.0-dev.20260929",
    "turbo": "^2.11.6",
    "yaml": "2.9.1"
  }
}
