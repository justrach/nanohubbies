{
  "origin": "https://nanohub.sh",
  "backend": "codegraff",
  "image": "registry.cloudflare.com/REPLACE_WITH_ACCOUNT_ID/nanohub-ci@sha256:REPLACE_WITH_VERIFIED_DIGEST",
  "imageRegistry": {
    "provider": "cloudflare",
    "config": "/etc/nanohub/wrangler.jsonc"
  },
  "network": "none",
  "artifacts": "/var/lib/nanohub-ci/private-artifacts",
  "concurrency": 8,
  "maxSandboxes": 16,
  "jobConcurrency": 4,
  "repositories": [
    {
      "repository": "nanohub/app",
      "runnerCredentialFile": "/etc/nanohub/app-runner.json"
    },
    {
      "repository": "nanohub/api",
      "runnerCredentialFile": "/etc/nanohub/api-runner.json"
    }
  ]
}
