      "css": ".ds-tabs{display:flex;gap:8px;overflow-x:auto;font-family:var(--font-sans)}.ds-tabs a{position:relative;padding:10px 12px;color:var(--ink-2);font-size:14px;text-decoration:none;white-space:nowrap;border-radius:6px}.ds-tabs a:hover{background:color-mix(in srgb,var(--ink) 6%,transparent)}.ds-tabs a[aria-current]{background:var(--raised);color:var(--ink);font-weight:600}.ds-tabs a:focus-visible{outline:2px solid var(--series-1);outline-offset:-2px}@media(max-width:640px){.ds-tabs{gap:0}.ds-tabs a{padding-inline:10px;font-size:13px}}"
