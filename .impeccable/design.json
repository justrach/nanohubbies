  "narrative": {
    "northStar": "Harness Paper/Graphite",
    "overview": "Harness Paper/Graphite is the approved incumbent repository world: warm cream or charcoal surfaces, dark or pale ink, amber actions and compact Geist text. This record captures the built repository workspace; it introduces no new visual direction.\n\nShared top navigation, bordered lists and modestly rounded controls keep code and repository state prominent. Branch administration extends the existing rows inline. The approved direction is recorded in `docs/design-variations/2026-10-26/selected-design.md`; the source remains authoritative for implementation.",
    "keyCharacteristics": [
      "Warm Paper/Graphite themes with amber actions.",
      "Compact Geist interface text and Geist Mono identifiers.",
      "Flat panels, visible dividers and shared top navigation."
    ],
    "rules": [
      {
        "name": "The Shared Theme Rule",
        "body": "Reuse the shared theme variables for local repository extensions.",
        "section": "colors"
      },
      {
        "name": "The Flat Panel Rule",
        "body": "Ordinary repository panels remain shadowless; anchored overlays may use their existing elevation.",
