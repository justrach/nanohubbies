    {
      "name": "Workspace primary button",
      "kind": "button",
      "description": "Small primary control; inherits the current runtime theme.",
      "html": "<button class=\"ds-button ds-primary\">Review rename</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:32px;padding:0 8px;border:1px solid var(--line);border-radius:var(--radius-control);font-family:var(--font-sans);font-size:13px;font-weight:500;cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast)}.ds-button:focus-visible{outline:2px solid var(--series-1);outline-offset:2px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-primary{background:var(--action);color:var(--action-ink);border-color:color-mix(in srgb,var(--action) 85%,#000)}.ds-primary:hover{background:color-mix(in srgb,var(--action) 92%,var(--ink))}.ds-primary:active{background:color-mix(in srgb,var(--action) 85%,var(--ink))}",
      "refersTo": "button-primary-paper"
    },
    {
      "name": "Workspace secondary button",
      "kind": "button",
      "description": "Bordered secondary repository control.",
      "html": "<button class=\"ds-button ds-secondary\">Refresh branches</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:32px;padding:0 8px;border:1px solid var(--line);border-radius:var(--radius-control);font-family:var(--font-sans);font-size:13px;font-weight:500;cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast)}.ds-button:focus-visible{outline:2px solid var(--series-1);outline-offset:2px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-secondary{background:var(--wash);color:var(--ink)}.ds-secondary:hover,.ds-secondary:active{background:var(--wash)}"
    },
    {
      "name": "Workspace ghost action",
      "kind": "button",
      "description": "Quiet inline action.",
      "html": "<button class=\"ds-button ds-ghost\">Cancel</button>",
      "css": ".ds-button{display:inline-flex;align-items:center;justify-content:center;min-height:32px;padding:0 8px;border:1px solid var(--line);border-radius:var(--radius-control);font-family:var(--font-sans);font-size:13px;font-weight:500;cursor:pointer;transition:background-color var(--duration-fast),color var(--duration-fast)}.ds-button:focus-visible{outline:2px solid var(--series-1);outline-offset:2px}.ds-button:disabled{pointer-events:none;opacity:.5}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}.ds-ghost{background:transparent;border-color:transparent;color:var(--ink-2)}.ds-ghost:hover,.ds-ghost:active{background:var(--wash);color:var(--ink)}"
    },
    {
      "name": "Rename field",
      "kind": "input",
      "description": "Existing labeled review field with rename geometry.",
      "html": "<label class=\"ds-label\">New branch name<input class=\"ds-field\" value=\"feature/new-name\" spellcheck=\"false\"></label>",
      "css": ".ds-label{display:grid;gap:5px;max-width:480px;color:var(--muted);font-family:var(--font-sans);font-size:12px}.ds-field{width:100%;min-width:0;height:34px;padding:8px 12px;background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:var(--radius-control);font-family:var(--font-sans);font-size:13px;outline:none}.ds-field:hover{border-color:var(--line)}.ds-field:focus-visible{border-color:var(--series-1)}.ds-field:disabled{cursor:default}"
    },
